FROM python:3.11-slim

WORKDIR /app

RUN pip install --no-cache-dir uv

COPY pyproject.toml ./
COPY src ./src
COPY scenarios ./scenarios
COPY specs ./specs

RUN uv sync --no-dev --extra webapp

# Dans le conteneur, écouter sur toutes les interfaces (Azure Container Apps).
ENV GRADIO_SERVER_NAME=0.0.0.0

EXPOSE 7860

CMD ["uv", "run", "--no-sync", "python", "-m", "kaldera.webapp.app"]
